generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TicketStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  SKIPPED
  CANCELLED
}

enum OrganizationRole {
  ADMIN
  STAFF
}

model Organization {
  id                String                         @id @default(cuid())
  name              String
  slug              String                         @unique
  timezone          String                         @default("Asia/Kolkata")
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  memberships       OrganizationMembership[]
  services          Service[]
  counters          Counter[]
  scheduleIntervals OrganizationScheduleInterval[]
  closures          OrganizationClosure[]
}

model User {
  id                 String                   @id @default(cuid())
  clerkId            String?                  @unique
  name               String?
  email              String                   @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memberships        OrganizationMembership[]
  tickets            Ticket[]
  counterAssignments StaffCounterAssignment[]
  appointments       Appointment[]
  ticketsServed      Ticket[]                 @relation("TicketsServed")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Service {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  isActive               Boolean  @default(true)
  admissionCutoffMinutes Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queues       Queue[]
  appointments Appointment[]

  @@unique([organizationId, name])
}

model Queue {
  id               String   @id @default(cuid())
  name             String
  serviceId        String
  nextTicketNumber Int      @default(1)
  lastResetDate    String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tickets          Ticket[]
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
}

model Ticket {
  id            String       @id @default(cuid())
  trackingToken String?      @unique
  number        Int
  status        TicketStatus @default(WAITING)
  queueId       String
  userId        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  calledAt                    DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  skippedAt                   DateTime?
  cancelledAt                 DateTime?
  initialEstimatedWaitMinutes Int?
  servedById                  String?
  counterId                   String?

  queue    Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  servedBy User?    @relation("TicketsServed", fields: [servedById], references: [id], onDelete: SetNull)
  counter  Counter? @relation(fields: [counterId], references: [id], onDelete: SetNull)

  @@index([queueId, number])
  @@index([queueId, status, number])
  @@index([servedById, status])
  @@index([userId])
}

model Appointment {
  id          String            @id @default(cuid())
  scheduledAt DateTime
  status      AppointmentStatus @default(BOOKED)
  serviceId   String
  userId      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([serviceId, scheduledAt])
}

model Counter {
  id               String                   @id @default(cuid())
  name             String
  organizationId   String
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  staffAssignments StaffCounterAssignment[]
  tickets          Ticket[]
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model StaffCounterAssignment {
  id        String   @id @default(cuid())
  userId    String
  counterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  counter Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)

  @@unique([userId, counterId])
}

model OrganizationScheduleInterval {
  id             String       @id @default(cuid())
  organizationId String
  dayOfWeek      Int          // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime      String       // Format: "HH:mm" (24-hour local time)
  endTime        String       // Format: "HH:mm" (24-hour local time)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, dayOfWeek])
}

model OrganizationClosure {
  id             String       @id @default(cuid())
  organizationId String
  startDate      String       // Format: "YYYY-MM-DD" in organization's local timezone
  endDate        String       // Format: "YYYY-MM-DD" in organization's local timezone
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startDate, endDate])
}

