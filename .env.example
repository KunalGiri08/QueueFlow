# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/queueflow?sslmode=disable"

# Clerk Authentication Keys
CLERK_SECRET_KEY="sk_test_placeholder"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"

# Dedicated isolated test database for concurrency integration tests (runs on port 5433 via docker-compose.test.yml)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/queueflow_test"

# Database readiness probe timeout in milliseconds (optional, defaults to 8000, min 1000, max 15000)
# Configures the watchdog timeout for GET /api/health database connectivity check.
HEALTH_DB_TIMEOUT_MS=8000

